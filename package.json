  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "build": "npm run build:db && npm run build:tailwind",
    "build:db": "node schema.js",
    "build:tailwind": "npx @tailwindcss/cli -i input.css -o renderer/build/output.css",
    "clean": "rm -rf renderer/build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "start": "electron-forge start -- --no-updates"
  },
