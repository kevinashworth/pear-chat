    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperdb": "^6.7.0",
    "hyperdispatch": "^1.6.0",
    "hyperschema": "^1.21.0",
    "hyperswarm": "^4.17.0",
    "paparam": "1.10.2",
    "pear-runtime": "1.3.1",
